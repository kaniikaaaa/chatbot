# Provide at least one provider key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Which provider/model new chats default to
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# 1 to strip emails/phones/cards/etc. from previews before they hit the DB
PII_REDACT=1

# Number of trailing messages sent back to the model as context
CONTEXT_TURNS=12
